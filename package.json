{
  "name": "@antelopejs/stripe",
  "version": "1.0.2",
  "description": "A flexible payment module that implements the Stripe interface of antelopejs",
  "keywords": [
    "antelopejs",
    "stripe",
    "payment",
    "billing",
    "checkout"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/stripe.git"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "build": "rimraf dist && tsc",
    "format": "oxfmt .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run test && pnpm run prepack && release-it",
    "test": "echo \"No test specified\"",
    "typecheck": "tsc --noEmit",
    "format:check": "oxfmt --check .",
    "knip": "knip"
  },
  "antelopeJs": {
    "implements": [
      "@antelopejs/interface-stripe"
    ],
    "defaultConfig": {
      "apiKey": "your_stripe_api_key",
      "webhookSecret": "your_stripe_webhook_secret",
      "endpoint": "stripe"
    }
  },
  "dependencies": {
    "@antelopejs/interface-api": ">=0.0.5 <1.0.0",
    "@antelopejs/interface-core": ">=0.0.5 <1.0.0",
    "@antelopejs/interface-redis": ">=0.0.6 <1.0.0",
    "@antelopejs/interface-stripe": ">=0.0.4 <1.0.0",
    "stripe": "^18.5.0",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "@antelopejs/tooling-configs": "^0.0.4",
    "@types/node": "^22.19.15",
    "@types/uuid": "10.0.0",
    "eslint-plugin-perfectionist": "^5.11.0",
    "knip": "^6.34.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  }
}
