{
  "name": "@antelopejs/stripe",
  "version": "1.1.0",
  "description": "A flexible payment module that implements the Stripe, payment and subscriptions interfaces of antelopejs",
  "keywords": [
    "antelopejs",
    "payment",
    "stripe",
    "webhook"
  ],
  "homepage": "https://interfaces.antelopejs.com/docs/stripe/introduction",
  "bugs": {
    "url": "https://github.com/AntelopeJS/stripe/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/stripe.git"
  },
  "files": [
    "dist",
    "!dist/test",
    "docs",
    "skills"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "format": "oxfmt .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run test && pnpm run prepack && release-it",
    "test": "pnpm run build && ajs module test . -f dist/test/provider-regressions.test.js -f dist/test/webhook-events.test.js -f dist/test/interface-stripe.test.js",
    "test:stripe": "pnpm run build && ANTELOPE_STRIPE_TEST_MODE=live ajs module test .",
    "typecheck": "tsc --noEmit",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "prepare": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1 && command -v lefthook >/dev/null 2>&1; then lefthook install; fi",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "ratchet": "antelopejs-ratchet",
    "sync": "antelopejs-sync",
    "ratchet:update": "antelopejs-ratchet --update",
    "sync:check": "antelopejs-sync --check"
  },
  "dependencies": {
    "@antelopejs/interface-core": ">=0.2.4 <1.0.0",
    "@antelopejs/interface-payment": ">=0.1.0 <0.2.0",
    "@antelopejs/interface-stripe": ">=0.0.6 <0.1.0",
    "@antelopejs/interface-subscriptions": ">=0.0.2 <0.1.0",
    "stripe": "^18.5.0",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "@antelopejs/core": "^1.16.0",
    "@antelopejs/tooling-configs": "^0.2.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.15",
    "@types/uuid": "10.0.0",
    "eslint-plugin-perfectionist": "^5.11.0",
    "knip": "^6.34.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@antelopejs/interface-api": ">=0.0.15 <1.0.0",
    "@antelopejs/interface-redis": ">=0.0.9 <1.0.0"
  },
  "packageManager": "pnpm@10.6.5",
  "antelopeJs": {
    "implements": [
      "@antelopejs/interface-payment",
      "@antelopejs/interface-stripe",
      "@antelopejs/interface-subscriptions"
    ],
    "defaultConfig": {
      "apiKey": "your_stripe_api_key",
      "webhookSecret": "your_stripe_webhook_secret",
      "endpoint": "stripe"
    },
    "test": "src/test/antelope.test.ts",
    "skills": [
      "./skills"
    ]
  }
}
